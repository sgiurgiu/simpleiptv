{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "simpleiptv",
  "version-string": "0.0.1",
  "dependencies": [
    "boost-asio",
    "boost-algorithm",
    "boost-beast",
    "boost-system",
    "boost-serialization",
    "boost-filesystem",
    "boost-program-options",
    "boost-signals2",
    "boost-url",
    "fmt",
    "spdlog",
    "sqlite3",
    "freetype",
    "vulkan-memory-allocator",
    "vulkan-validationlayers",
    "volk",
    "glslang",
    "spirv-cross",
    "spirv-headers",
    "openssl",
    "zlib",
    "stb",
    "nlohmann-json",
    "date",
    {
      "name": "glfw3",
      "features": [
        {
          "name": "wayland",
          "platform": "linux"
        }
      ]
    },
    {
      "name": "soci",
      "default-features": false,
      "features": [
        "sqlite3"
      ]
    },
    {
      "name": "sdbus-cpp",
      "features": [
        "tool"
      ],
      "platform": "linux"
    },
    {
      "name":"ffmpeg",
      "default-features": false,
      "features": [
        "nonfree",
        "dav1d",
        "avresample",
        "avformat",
        "avcodec",
        "avfilter",
        "swresample",
        "swscale",
        "vpx",
        "x264",
        "x265",
        "mp3lame",
        "aom"
      ]
    },
    "libebur128",
    "libass",
    "libmpv"
  ],
  "features": {
    "app": {
      "description": "Simple IPTV"
    },
    "tests": {
      "description": "Build tests",
      "dependencies": [
        "gtest"
      ]
    }
  }
}
