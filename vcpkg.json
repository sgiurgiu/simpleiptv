{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "simpleiptv",
  "version-string": "0.0.1",
  "builtin-baseline": "d4f3e122069912636c123b7ece673f6e01513cea",
  "dependencies": [
    "boost-asio",
    "boost-algorithm",
    "boost-beast",
    "boost-system",
    "boost-serialization",
    "boost-filesystem",
    "boost-program-options",
    "boost-signals2",
    "boost-url",
    "glew",
    "fmt",
    "spdlog",
    "sqlite3",
    "freetype",
    "opengl",
    "openssl",
    "zlib",
    "stb",
    "nlohmann-json",
    {
      "name": "glfw3",
      "features": [
        {
          "name": "wayland",
          "platform": "linux"
        }
      ]
    },
    {
      "name": "imgui",
      "default-features": false,
      "features": [
        "opengl3-binding",
        "glfw-binding",
        "freetype-lunasvg"
      ]
    },
    {
      "name": "soci",
      "default-features": false,
      "features": [
        "sqlite3"
      ]
    },
    {
      "name": "sdbus-cpp",
      "features": [
        "tool"
      ],
      "platform": "linux"
    }
  ],
  "features": {
    "app": {
      "description": "Simple IPTV"
    },
    "tests": {
      "description": "Build tests",
      "dependencies": [
        "gtest"
      ]
    }
  }
}
