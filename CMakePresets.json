{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "description": "Default build using Ninja generator",
            "generator": "Ninja",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "environment": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "default",
            "binaryDir": "${sourceDir}/build",
            "inherits": "base",
            "description": "Default build using Ninja generator",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTS": "ON",
                "CMAKE_C_COMPILER":"/usr/bin/clang",
                "CMAKE_CXX_COMPILER":"/usr/bin/clang++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "asan",
            "inherits": "default",
            "cacheVariables": {
                "ASAN_ENABLE": "ON",
                "SIMPLEIPTV_SANITIZER":"address"
            }
        },
        {
            "name": "tsan",
            "inherits": "default",
            "cacheVariables": {
                "ASAN_ENABLE": "ON",
                "SIMPLEIPTV_SANITIZER":"thread",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build-release",
            "description": "Release build using Ninja generator",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TESTS": "OFF",
                "CMAKE_INSTALL_PREFIX": "/usr",
                "SIMPLEIPTV_DEBUGINFO": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "release-debuginfo",
            "inherits": "release",
            "description": "Release build carrying DWARF for the project's own sources; the RPM gets a -debuginfo subpackage",
            "cacheVariables": {
                "SIMPLEIPTV_DEBUGINFO": "ON"
            }
        },
        {
            "name": "release-windows",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build-release",
            "description": "Windows release build using Ninja generator",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TESTS": "OFF",
				"VCPKG_TARGET_TRIPLET" : "x64-windows-static",
				"CMAKE_TOOLCHAIN_FILE" : "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_MAKE_PROGRAM" : "C:/ninja-win/ninja.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "jobs": 16
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "jobs": 16
        },
        {
            "name": "tsan",
            "configurePreset": "tsan",
            "jobs": 16
        },
        {
            "name": "release",
            "configurePreset": "release",
            "cleanFirst": true,
            "jobs": 16
        },
        {
            "name": "release-debuginfo",
            "configurePreset": "release-debuginfo",
            "cleanFirst": true,
            "jobs": 8
        },
        {
            "name": "release-windows",
            "configurePreset": "release-windows",
            "cleanFirst": true,
            "jobs": 8
        }
    ],
    "packagePresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "generators": [
                "RPM"
            ]
        },
        {
            "name": "release",
            "configurePreset": "release",
            "generators": [
                "RPM"
            ]
        },
        {
            "name": "release-debuginfo",
            "configurePreset": "release-debuginfo",
            "generators": [
                "RPM"
            ]
        },
        {
            "name": "release-tgz",
            "configurePreset": "release",
            "generators": [
                "TGZ"
            ]
        },
        {
            "name": "release-deb",
            "configurePreset": "release",
            "generators": [
                "DEB"
            ]
        },
        {
            "name": "release-windows",
            "configurePreset": "release-windows",
            "generators": [
                "WIX"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "release-windows-zip",
            "configurePreset": "release-windows",
            "generators": [
                "ZIP"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "default",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "default"
                },
                {
                    "type": "package",
                    "name": "default"
                }
            ]
        },
        {
            "name": "release",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "release"
                },
                {
                    "type": "package",
                    "name": "release"
                }
            ]
        },
        {
            "name": "release-debuginfo",
            "steps": [
                {
                    "type": "configure",
                    "name": "release-debuginfo"
                },
                {
                    "type": "build",
                    "name": "release-debuginfo"
                },
                {
                    "type": "package",
                    "name": "release-debuginfo"
                }
            ]
        },
        {
            "name": "release-deb",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "release"
                },
                {
                    "type": "package",
                    "name": "release-deb"
                }
            ]
        },
        {
            "name": "release-tgz",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "release"
                },
                {
                    "type": "package",
                    "name": "release-tgz"
                }
            ]
        },
        {
            "name": "release-windows",
            "steps": [
                {
                    "type": "configure",
                    "name": "release-windows"
                },
                {
                    "type": "build",
                    "name": "release-windows"
                },
                {
                    "type": "package",
                    "name": "release-windows"
                }
            ]
        },
        {
            "name": "release-windows-zip",
            "steps": [
                {
                    "type": "configure",
                    "name": "release-windows"
                },
                {
                    "type": "build",
                    "name": "release-windows"
                },
                {
                    "type": "package",
                    "name": "release-windows-zip"
                }
            ]
        }
    ]
}
