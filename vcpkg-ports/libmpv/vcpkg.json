{
  "name": "libmpv",
  "version": "0.41.0",
  "port-version": 12,
  "description": "LibMPV port",
  "homepage": "https://github.com/sgiurgiu/mpv",
  "license": "MIT",
  "dependencies": [
    {
      "name": "vcpkg-tool-meson",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "libplacebo",
      "default-features": false,
      "features": [
        "vulkan",
        "shaderc",
        "xxhash"
      ]
    },
    "libass",
    "vulkan-headers",
    {
      "name": "vulkan-loader",
      "platform": "windows & !uwp"
    },
    "ffmpeg",
    "libarchive",
    "libiconv",
    "libpng",
    "libjpeg-turbo",
    "libwebp"
  ]
}
